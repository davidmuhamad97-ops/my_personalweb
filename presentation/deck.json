          "type": "rectangle",
          "left": 0.7,
          "top": 1.75,
          "width": 7.3,
          "height": 4.9,
          "fill": "1E293B",
          "text": "export function AnimatedAvatar({ name }) {\n  const initials = name\n    .split(' ')\n    .map(p => p.charAt(0))\n    .slice(0, 2)\n    .join('')\n    .toUpperCase();\n\n  return (\n    <div className=\"relative\">\n      <div className=\"conic-gradient animate-spin-slow\" />\n      <div className=\"bg-slate-900 rounded-full\">\n        {initials}\n      </div>\n      <div className=\"blur-xl animate-pulse-soft\" />\n    </div>\n  );\n}",
          "text_color": "E2E8F0",
          "text_size": 13,
          "text_font": "Consolas"
        },
        {
          "type": "rectangle",
          "left": 8.3,
          "top": 1.75,
          "width": 4.4,
          "height": 4.9,
          "fill": "EEF2FF",
          "text": "Anotasi:\n\n1. Inisial dihitung dari nama,\n   lalu dirender di lingkaran tengah.\n\n2. Ring conic-gradient berputar\n   via keyframe CSS spin-slow.\n\n3. Glow blur di belakang memakai\n   animate-pulse-soft.\n\n4. Semua animasi murni CSS,\n   tanpa library eksternal.",
          "text_color": "1E1B4B",
          "text_size": 13,
          "text_font": "Calibri"
        }
      ]
