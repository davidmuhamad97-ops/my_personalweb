      "shapes": [
        {"type": "rectangle", "left": 0.7, "top": 0.7, "width": 7.3, "height": 0.9, "fill": "6366F1", "text": "Potongan Kode — AnimatedAvatar", "text_color": "FFFFFF", "text_size": 20, "text_bold": true, "text_font": "Calibri"},
